DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/auth/google/callback
APP_URL=https://your-domain.vercel.app
SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long
SERPER_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.6-sol
# Local development only; Vercel deployments use OIDC when AI Gateway is enabled.
AI_GATEWAY_API_KEY=

# Paddle Billing — SANDBOX ONLY. Never use live credentials in this project.
PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_sandbox_client_token
PADDLE_API_KEY=your_sandbox_api_key_suffixed_with_sdbx
PADDLE_WEBHOOK_SECRET=your_sandbox_notification_destination_secret

# PayPal subscriptions — configure only after owner-approved sandbox/live setup.
# Checkout stays disabled until all six values are present, including the webhook ID.
# Keep PAYPAL_CLIENT_SECRET server-side only. Values are intentionally blank.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=
PAYPAL_WEBHOOK_ID=
PAYPAL_MONTHLY_PLAN_ID=
PAYPAL_YEARLY_PLAN_ID=
